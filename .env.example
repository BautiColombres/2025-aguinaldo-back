# Database Configuration
# Provided automatically by Render when using managed PostgreSQL
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=medibook
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password

# Server Configuration
# Provided automatically by Render
PORT=10000

# JWT Configuration
# JWT_SECRET — REQUIRED, no default. Must be at least 32 bytes (256 bits).
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes
# JWT_DURATION — REQUIRED, no default. Token lifetime in milliseconds (must be > 0).
JWT_DURATION=3600000

# Frontend URL (used by emails / links)
# For local development set to your frontend dev server (Vite default port is 5173 in this project)
# For production / hosted on Render set to: https://medi-book-web.onrender.com/
FRONTEND_URL=http://localhost:5173

# CORS Configuration
# Comma-separated pinned origins. For local development include the Vite dev origin.
# Update with your actual frontend URL after deployment. Wildcards are NOT allowed
# (credentials are enabled for the refresh cookie).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Refresh-token cookie (FSEC-H1) — optional overrides.
# APP_COOKIE_SECURE: MUST be false for local DEV (plain http localhost) so the
# browser stores the cookie; leave unset/true in production (https).
APP_COOKIE_SECURE=false
# APP_COOKIE_SAME_SITE: Strict by default. Set to None (and APP_COOKIE_SECURE=true)
# only if the front and back are deployed on different registrable domains.
APP_COOKIE_SAME_SITE=Strict

# Admin bootstrap (BSEC-H-4) — REQUIRED, no default.
# The admin account is provisioned at startup from these vars (BCrypt-encoded,
# mustResetPassword=true). The app REFUSES TO BOOT if either is missing.
# There is NO committed admin credential anymore (seed admin is neutralized).
ADMIN_EMAIL=admin@medibook.com
ADMIN_PASSWORD=change-me-to-a-strong-admin-password
# Optional: DNI assigned to a newly-created admin (defaults to 99999999).
ADMIN_DNI=99999999

# GymCloud inbound API keys (comma-separated) — REQUIRED, no default.
GYMCLOUD_API_KEYS=change-me

# Google Apps Script token (email) — REQUIRED, no default.
GOOGLE_APPS_SCRIPT_TOKEN=change-me

# Medical-check (GymCloud) API key — REQUIRED, no default.
MEDICAL_CHECK_API_KEY=change-me

# MailerSend Configuration
MAILERSEND_ENABLED=true
MAILERSEND_API_TOKEN=your_mailersend_api_token_here
MAILERSEND_FROM_EMAIL=noreply@yourdomain.com
MAILERSEND_FROM_NAME=MediBook

# Supabase Storage S3 Configuration
SUPABASE_S3_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-2
SUPABASE_S3_ACCESS_KEY=your_access_key_here
SUPABASE_S3_SECRET_KEY=your_secret_key_here