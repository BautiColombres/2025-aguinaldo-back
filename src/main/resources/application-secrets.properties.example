# MediBook API — secrets template
#
# Copy this file to `application-secrets.properties` (same directory) and fill in
# real values, OR provide the equivalent environment variables (spring-dotenv
# reads a gitignored `.env`). `application-secrets.properties` is gitignored and
# imported optionally by application.properties via:
#   spring.config.import=optional:classpath:application-secrets.properties
#
# NONE of these have hardcoded defaults in application.properties anymore:
# the application FAILS FAST at startup if the required ones are missing.

# JWT signing key — REQUIRED. Must be at least 32 bytes (256 bits).
jwt.secret=change-me-to-a-random-secret-of-at-least-32-bytes

# JWT token lifetime in milliseconds — REQUIRED. Must be a positive number
# (no default; a missing/empty value fails fast at startup). 3600000 = 1 hour.
jwt.expiration=3600000

# External medical-check (GymCloud) API key — REQUIRED.
medical.check.api.key=replace-with-real-medical-check-api-key

# Database — REQUIRED (no default; missing fails fast).
spring.datasource.password=change-me

# Supabase Storage (S3) — REQUIRED (no defaults; missing fails fast).
supabase.s3.access-key=change-me
supabase.s3.secret-key=change-me

# Google Apps Script (email) — REQUIRED (no default; missing fails fast).
google.apps.script.token=change-me

# GymCloud inbound API keys (comma-separated) — REQUIRED (no default).
gymcloud.api.keys=change-me

# Admin bootstrap — REQUIRED. The admin account is created/updated at
# startup from these values (BCrypt-encoded). The app REFUSES TO BOOT if email or
# password is missing. No committed admin credential. No forced first-login reset
# (rotate the password here).
admin.bootstrap.email=admin@medibook.com
admin.bootstrap.password=change-me-to-a-strong-admin-password
# Optional: DNI assigned to a newly-created admin (defaults to 99999999).
admin.bootstrap.dni=99999999
