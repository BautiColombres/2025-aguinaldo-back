<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!--
      Normalized tag storage for medical history entries.
      One row per (medical_history_id, tag). Backs the per-patient /
      per-doctor tag-frequency query.

      INVARIANT: the JPA @ElementCollection mapping in
      entity/MedicalHistory.java MUST use exactly:
        @CollectionTable(name = "medical_history_tags",
            joinColumns = @JoinColumn(name = "medical_history_id"))
        @Column(name = "tag")
      H2 tests skip Liquibase (Hibernate-generated schema), so a name
      mismatch here would pass every H2 test and only break on Postgres.
    -->
    <changeSet id="0015-01-medical-history-tags" author="MediBook_Agent">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="medical_history_tags"/>
            </not>
        </preConditions>

        <createTable tableName="medical_history_tags">
            <column name="medical_history_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="tag" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="medical_history_tags"
                                 baseColumnNames="medical_history_id"
                                 constraintName="fk_medical_history_tags_history"
                                 referencedTableName="medical_history"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <!-- Supports the join from medical_history to its tags. -->
        <createIndex indexName="idx_medical_history_tags_history_id"
                     tableName="medical_history_tags">
            <column name="medical_history_id"/>
        </createIndex>

        <!-- Composite index supporting the GROUP BY tag frequency query
             (join on medical_history_id, aggregate over tag). -->
        <createIndex indexName="idx_medical_history_tags_history_tag"
                     tableName="medical_history_tags">
            <column name="medical_history_id"/>
            <column name="tag"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
