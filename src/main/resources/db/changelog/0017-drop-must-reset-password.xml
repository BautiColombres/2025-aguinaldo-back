<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!--
        Drop the dormant users.must_reset_password flag (added in 0011-01).

        Rationale: the column was written (AdminProvisioningRunner set it to true for the
        env-provisioned admin, and 0011-02 set it on the neutralized seed admin) but it was
        NEVER read: signin does not check it, so no user was ever forced to reset a password.
        A security control that appears to exist but does nothing is worse than no control at
        all — it misleads the next reader into believing first-login reset is covered.

        Product decision: remove the flag instead of building the full forced-reset flow
        (persisted state + signin gate + a blocking "set new password" screen). If forced
        reset is implemented later, re-add the column in a NEW changelog together with the
        code that actually enforces it.

        NOTE: 0011 is intentionally left untouched — editing an already-applied changeSet
        breaks Liquibase checksums. On a fresh database 0011 still adds and populates the
        column; this changeSet then drops it. That is correct and idempotent.
    -->
    <changeSet id="0017-01-drop-must-reset-password" author="MediBook_Security">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="users" columnName="must_reset_password"/>
        </preConditions>

        <comment>Remove never-enforced must_reset_password flag from users.</comment>

        <dropColumn tableName="users" columnName="must_reset_password"/>

        <!--
            Rollback restores the column and its NOT NULL default, but NOT the per-row values
            (they are unrecoverable once dropped). Every row comes back as false, which matches
            the semantics of a flag nothing enforces.
        -->
        <rollback>
            <addColumn tableName="users">
                <column name="must_reset_password" type="boolean" defaultValueBoolean="false">
                    <constraints nullable="false"/>
                </column>
            </addColumn>
        </rollback>
    </changeSet>

</databaseChangeLog>
